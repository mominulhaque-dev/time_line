{%- comment -%} All collections listing. {%- endcomment -%}
<section class="texan_container">
  {%- if section.settings.heading != blank -%}
    <div class="texan_section_heading" style="margin-top: 2rem;">
      <h1>{{ section.settings.heading }}</h1>
    </div>
  {%- endif -%}
  <div class="texan_collection_list">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="texan_collection_tile">
        {%- if collection.image or collection.products.first.featured_media -%}
          {%- assign tile_img = collection.image | default: collection.products.first.featured_media -%}
          {%- assign tile_alt = collection.title | escape -%}
          {{ tile_img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 900px) 33vw, 50vw', alt: tile_alt }}
        {%- endif -%}
        <span>{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Shop by collection" }
  ]
}
{% endschema %}
