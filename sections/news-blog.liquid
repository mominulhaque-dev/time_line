{%- comment -%} Latest blog posts grid. {%- endcomment -%}
{%- liquid
  assign blog = blogs[section.settings.blog]
  assign limit = section.settings.posts_to_show
-%}
<section class="texan_news texan_container" id="{{ section.settings.anchor | default: 'texan_news' }}" aria-labelledby="texan_news_title_{{ section.id }}">
  <div class="texan_section_heading">
    {%- if section.settings.heading != blank -%}
      <h2 id="texan_news_title_{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="texan_outline_link" href="{{ blog.url | default: '#' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="texan_news_grid">
    {%- if blog.articles.size > 0 -%}
      {%- for article in blog.articles limit: limit -%}
        {% render 'article-card', article: article %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <article class="texan_article_card" data_texan_reveal>
          {{ 'image' | placeholder_svg_tag: 'texan_placeholder' }}
          <p>Nutrition &middot; Example</p>
          <h3>Example blog post title goes here</h3>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.news.name",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "texan_news" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Latest news" },
    { "type": "text", "id": "link_label", "label": "t:sections.all.link_label", "default": "Our blog" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 8, "step": 1, "label": "Posts to show", "default": 4 }
  ],
  "presets": [{ "name": "t:sections.news.name" }]
}
{% endschema %}
