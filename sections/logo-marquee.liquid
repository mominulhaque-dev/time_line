{%- comment -%} Press / brand logo marquee. Blocks = text or image logos. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="texan_logo_marquee texan_marquee_wrap" aria-label="{{ section.settings.label | default: 'Featured press' | escape }}" style="--marquee_duration: {{ section.settings.speed }}s;">
    <div class="texan_marquee_track">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            {%- assign logo_alt = block.settings.text | default: 'Press logo' | escape -%}
            <span {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: logo_alt }}</span>
          {%- else -%}
            <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.logo_marquee.name",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Featured press" },
    { "type": "range", "id": "speed", "min": 15, "max": 80, "step": 5, "unit": "s", "label": "Scroll duration", "default": 36 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo_marquee.logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.all.image" },
        { "type": "text", "id": "text", "label": "Text (if no image)", "default": "Forbes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo_marquee.name",
      "blocks": [
        { "type": "logo", "settings": { "text": "Forbes" } },
        { "type": "logo", "settings": { "text": "Financial Times" } },
        { "type": "logo", "settings": { "text": "Popular Science" } },
        { "type": "logo", "settings": { "text": "Runner's World" } },
        { "type": "logo", "settings": { "text": "Medical News Today" } }
      ]
    }
  ]
}
{% endschema %}
