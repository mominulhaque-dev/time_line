{%- comment -%} Search results page. {%- endcomment -%}
<section class="texan_search_page texan_container">
  <div class="texan_search_header">
    {%- if search.performed -%}
      <h1>{{ 'general.search.results_for' | t: terms: search.terms }}</h1>
      <p class="texan_collection_count">{{ 'products.facets.product_count' | t: count: search.results_count }}</p>
    {%- else -%}
      <h1>{{ 'general.search.title' | t }}</h1>
    {%- endif -%}
    <form action="{{ routes.search_url }}" method="get" role="search" class="texan_search_form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}">
      <button type="submit">{{ 'general.search.submit' | t }}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <div class="texan_collection_empty">
        <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      </div>
    {%- else -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        <div class="texan_product_grid texan_collection_grid">
          {%- for item in search.results -%}
            {%- case item.object_type -%}
              {%- when 'product' -%}
                {% render 'product-card', product: item, show_quick_add: true %}
              {%- when 'article' -%}
                {% render 'article-card', article: item, show_excerpt: true %}
              {%- when 'page' -%}
                <article class="texan_article_card" data_texan_reveal>
                  <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <div class="texan_article_excerpt">{{ item.content | strip_html | truncatewords: 20 }}</div>
                </article>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "range", "id": "results_per_page", "min": 8, "max": 36, "step": 4, "label": "Results per page", "default": 16 }
  ]
}
{% endschema %}
