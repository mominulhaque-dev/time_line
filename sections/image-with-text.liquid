{%- comment -%} Generic image + text, reversible. Reusable on About etc. {%- endcomment -%}
<section class="texan_iwt texan_container texan_iwt_{{ section.settings.layout }}">
  <div class="texan_iwt_media" data_texan_reveal>
    {%- if section.settings.image != blank -%}
      {%- assign iwt_alt = section.settings.heading | escape -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 760px) 50vw, 100vw', alt: iwt_alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'texan_placeholder' }}
    {%- endif -%}
  </div>
  <div class="texan_iwt_copy" data_texan_reveal>
    {%- if section.settings.eyebrow != blank -%}<p class="texan_rt_eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="texan_rt_body rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.link_label != blank -%}<a class="texan_button" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  .texan_iwt {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .texan_iwt_media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .texan_iwt_copy {
    display: grid;
    gap: 1rem;
    align-content: center;
  }
  .texan_iwt_copy h2 {
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }
  @media (min-width: 760px) {
    .texan_iwt {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .texan_iwt_reverse .texan_iwt_media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.all.image" },
    { "type": "select", "id": "layout", "label": "Media position", "options": [ { "value": "default", "label": "Left" }, { "value": "reverse", "label": "Right" } ], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About us" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Backed by 18 years of research" },
    { "type": "richtext", "id": "text", "label": "t:sections.all.content", "default": "<p>Tell your story here with supporting detail.</p>" },
    { "type": "text", "id": "link_label", "label": "t:sections.all.link_label" },
    { "type": "url", "id": "link", "label": "t:sections.all.link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
