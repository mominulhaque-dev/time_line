{%- comment -%} Reset password. {%- endcomment -%}
<section class="texan_customer texan_container">
  <div class="texan_customer_card">
    <h1>Reset your password</h1>
    {%- form 'reset_customer_password', class: 'texan_customer_form' -%}
      {%- if form.errors -%}<p class="texan_form_error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="texan_field">
        <label for="texan_reset_password">New password</label>
        <input id="texan_reset_password" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="texan_field">
        <label for="texan_reset_confirm">Confirm password</label>
        <input id="texan_reset_confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="texan_button">Reset password</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
