{%- comment -%} Customer account dashboard: order history + details. {%- endcomment -%}
<section class="texan_customer texan_container">
  <header class="texan_account_header">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="texan_outline_link">{{ 'customer.account.log_out' | t }}</a>
  </header>

  <div class="texan_account_grid">
    <div class="texan_account_orders">
      <h2>{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 12 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="texan_orders_table">
            <thead>
              <tr>
                <th>{{ 'customer.orders.order_number' | t }}</th>
                <th>{{ 'customer.orders.date' | t }}</th>
                <th>{{ 'customer.orders.status' | t }}</th>
                <th>{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%b %-d, %Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.total_net_amount | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p class="texan_account_empty">{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <aside class="texan_account_details">
      <h2>{{ 'customer.account.details' | t }}</h2>
      <p>{{ customer.name }}</p>
      {%- if customer.default_address -%}
        <div class="texan_account_address">{{ customer.default_address | format_address }}</div>
      {%- endif -%}
      <a href="{{ routes.account_addresses_url }}" class="texan_outline_link">{{ 'customer.account.addresses' | t }}</a>
    </aside>
  </div>
</section>

{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
