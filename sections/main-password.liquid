{%- comment -%} Storefront password / coming-soon page. {%- endcomment -%}
<div class="texan_password">
  <div class="texan_password_inner">
    <p class="texan_logo_link"><span>{{ section.settings.logo_left | default: 'time' }}</span><i></i><span>{{ section.settings.logo_right | default: 'line' }}</span></p>
    {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="texan_rt_body rte">{{ section.settings.text }}</div>{%- endif -%}

    {%- form 'customer', class: 'texan_newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      {%- if form.posted_successfully? -%}
        <p class="texan_form_success">{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        <label class="texan_screen_reader" for="texan_pw_email">{{ 'general.newsletter.placeholder' | t }}</label>
        <div>
          <input id="texan_pw_email" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
          <button type="submit" aria-label="{{ 'general.newsletter.submit' | t }}">{% render 'icon', name: 'arrow_right' %}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="texan_password_login">
      <summary>Enter using password</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="texan_form_error">{{ form.errors.messages.form }}</p>{%- endif -%}
        <div class="texan_field">
          <label for="texan_pw_input" class="texan_screen_reader">Password</label>
          <input type="password" id="texan_pw_input" name="password" placeholder="Password">
        </div>
        <button type="submit" class="texan_button">Enter</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% stylesheet %}
  .texan_password { display: grid; place-items: center; min-height: 100vh; padding: 2rem; text-align: center; }
  .texan_password_inner { display: grid; gap: 1.2rem; justify-items: center; max-width: 30rem; }
  .texan_password h1 { font-size: clamp(2rem, 6vw, 3.4rem); letter-spacing: -0.06em; }
  .texan_password_login { margin-top: 1rem; }
  .texan_password_login summary { font-size: 0.66rem; font-weight: 800; text-transform: uppercase; cursor: pointer; }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "logo_left", "label": "Logo left", "default": "time" },
    { "type": "text", "id": "logo_right", "label": "Logo right", "default": "line" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Opening soon" },
    { "type": "richtext", "id": "text", "label": "t:sections.all.content", "default": "<p>Be the first to know when we launch.</p>" }
  ]
}
{% endschema %}
