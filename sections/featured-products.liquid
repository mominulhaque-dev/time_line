{%- comment -%} Featured product grid from a collection + optional promo card. {%- endcomment -%}
{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}
<section class="texan_products texan_container" id="{{ section.settings.anchor | default: 'texan_shop' }}" aria-labelledby="texan_products_title_{{ section.id }}">
  <div class="texan_section_heading">
    {%- if section.settings.heading != blank -%}
      <h2 id="texan_products_title_{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="texan_outline_link" href="{{ collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="texan_product_grid">
    {%- if collection.products.size > 0 -%}
      {%- for product in collection.products limit: limit -%}
        {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, lazy: true %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <article class="texan_product_card" data_texan_reveal>
          <div class="texan_product_card_media">
            <figure>{{ 'product-apparel-1' | placeholder_svg_tag: 'texan_placeholder' }}</figure>
          </div>
          <div class="texan_product_card_body">
            <h3>Example product</h3>
            <div class="texan_price"><span class="texan_price_current">$85.00</span></div>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}

    {%- if section.settings.show_promo -%}
      <article class="texan_skin_card" data_texan_reveal>
        {%- if section.settings.promo_eyebrow != blank -%}<p>{{ section.settings.promo_eyebrow }}</p>{%- endif -%}
        <h3>{{ section.settings.promo_heading }}</h3>
        {%- if section.settings.promo_link_label != blank -%}<a href="{{ section.settings.promo_link | default: '#' }}">{{ section.settings.promo_link_label }}</a>{%- endif -%}
      </article>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_products.name",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "texan_shop" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Products powered by Mitopure" },
    { "type": "text", "id": "link_label", "label": "t:sections.all.link_label", "default": "Shop all" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 3 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Enable quick add", "default": true },
    { "type": "header", "content": "Promo card" },
    { "type": "checkbox", "id": "show_promo", "label": "Show promo card", "default": true },
    { "type": "text", "id": "promo_eyebrow", "label": "Eyebrow", "default": "mitopure" },
    { "type": "text", "id": "promo_heading", "label": "t:sections.all.heading", "default": "Now available as Skincare" },
    { "type": "text", "id": "promo_link_label", "label": "t:sections.all.link_label", "default": "Shop skincare" },
    { "type": "url", "id": "promo_link", "label": "t:sections.all.link" }
  ],
  "presets": [{ "name": "t:sections.featured_products.name" }]
}
{% endschema %}
