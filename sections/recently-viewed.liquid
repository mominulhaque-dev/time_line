{%- comment -%}
  Recently viewed products. Tracks product handles in localStorage and fetches
  each product card via the Section Rendering API of a hidden card renderer.
{%- endcomment -%}
<section
  class="texan_products texan_container"
  data_texan_recently_viewed
  data-current="{{ product.handle }}"
  data-limit="{{ section.settings.products_to_show }}"
  hidden
>
  <div class="texan_section_heading">
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="texan_product_grid" data_texan_rv_grid></div>
</section>

{% javascript %}
  (() => {
    const KEY = "texan_recently_viewed";
    const root = document.querySelector("[data_texan_recently_viewed]");
    if (!root) return;

    const current = root.dataset.current;
    const limit = Number(root.dataset.limit) || 4;
    let list = [];
    try {
      list = JSON.parse(localStorage.getItem(KEY)) || [];
    } catch (_) {}

    const toRender = list.filter((h) => h !== current).slice(0, limit);
    const grid = root.querySelector("[data_texan_rv_grid]");
    const base = (window.Shopify?.routes?.root || "/") + "products/";

    Promise.all(
      toRender.map((handle) =>
        fetch(`${base}${handle}?section_id=card-renderer`)
          .then((r) => (r.ok ? r.text() : ""))
          .then((text) => {
            const html = new DOMParser().parseFromString(text, "text/html");
            return html.querySelector(".texan_product_card")?.outerHTML || "";
          })
          .catch(() => "")
      )
    ).then((cards) => {
      const html = cards.filter(Boolean).join("");
      if (html) {
        grid.innerHTML = html;
        root.hidden = false;
      }
    });

    // record current product
    if (current) {
      list = [current, ...list.filter((h) => h !== current)].slice(0, 20);
      localStorage.setItem(KEY, JSON.stringify(list));
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Recently viewed" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
