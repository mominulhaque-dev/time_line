{%- comment -%} Serif intro statement + clinical-proof metric grid (blocks). {%- endcomment -%}
<section class="texan_intro texan_container" aria-labelledby="texan_intro_title_{{ section.id }}">
  <div class="texan_intro_copy" data_texan_reveal>
    {%- if section.settings.heading != blank -%}
      <h2 id="texan_intro_title_{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="texan_outline_link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="texan_metric_grid" aria-label="Clinical proof metrics">
      {%- for block in section.blocks -%}
        <article data_texan_reveal {{ block.shopify_attributes }}>
          <strong>{{ block.settings.value }}</strong>
          <h3>{{ block.settings.label }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.intro_metrics.name",
  "max_blocks": 8,
  "settings": [
    { "type": "richtext", "id": "heading", "label": "t:sections.all.heading", "default": "<p>Time to give your cells new life with high-performance products powered by <em>mitopure</em>, our powerful ingredient that unlocks a precise dose of the rare Urolithin A molecule and promotes healthy aging.</p>" },
    { "type": "text", "id": "link_label", "label": "t:sections.all.link_label", "default": "Discover our science" },
    { "type": "url", "id": "link", "label": "t:sections.all.link" }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric",
      "settings": [
        { "type": "text", "id": "value", "label": "t:sections.intro_metrics.metric_value", "default": "18" },
        { "type": "text", "id": "label", "label": "t:sections.intro_metrics.metric_label", "default": "Years of research" },
        { "type": "text", "id": "text", "label": "t:sections.intro_metrics.metric_text", "default": "In collaboration with the Swiss Federal Institute of Technology of Lausanne." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.intro_metrics.name",
      "blocks": [
        { "type": "metric", "settings": { "value": "18", "label": "Years of research", "text": "In collaboration with the Swiss Federal Institute of Technology of Lausanne." } },
        { "type": "metric", "settings": { "value": "25", "label": "Human clinical trials", "text": "Completed and ongoing gold standard clinical trials involving over 1000 participants." } },
        { "type": "metric", "settings": { "value": "500+", "label": "Studies on Urolithin A", "text": "Scientists have extensively explored the effectiveness of Urolithin A on health." } },
        { "type": "metric", "settings": { "value": "80", "label": "Patents", "text": "Our proprietary ingredient Mitopure is protected under US patents." } }
      ]
    }
  ]
}
{% endschema %}
